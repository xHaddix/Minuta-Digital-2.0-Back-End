# ==============================
# App
# ==============================
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ==============================
# JWT
# ==============================
JWT_SECRET=super-secret-change-me
JWT_EXPIRES_IN=1d

# ==============================
# PostgreSQL - Base de datos central
# ==============================
DATABASE_URL=postgresql://minuta_admin:minuta_pass@localhost:5432/central_db?schema=public

POSTGRES_USER=minuta_admin
POSTGRES_PASSWORD=minuta_pass
POSTGRES_DB=central_db

# ==============================
# MinIO / S3
# ==============================
# Supabase Storage S3-compatible. Reemplaza credenciales antes del despliegue.
STORAGE_ENDPOINT=https://yorykcqutqojptbfywow.storage.supabase.co/storage/v1/s3
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=TU_ACCESS_KEY_ID_REAL
STORAGE_SECRET_ACCESS_KEY=TU_SECRET_ACCESS_KEY_REAL
STORAGE_BUCKET_NAME=minuta-digital-assets
STORAGE_PUBLIC_URL=https://yorykcqutqojptbfywow.supabase.co/storage/v1/object/public/minuta-digital-assets
S3_FORCE_PATH_STYLE=true

MINIO_ROOT_USER=minuta_access_key
MINIO_ROOT_PASSWORD=minuta_secret_key

# ==============================
# Correo (SMTP) - Mailpit en local (UI: http://localhost:8025)
# ==============================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Minuta Digital <no-reply@minutadigital.local>"

# URL del frontend, usada para construir enlaces de activación/recuperación
FRONTEND_URL=http://localhost:5173
