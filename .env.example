# ==============================
# App
# ==============================
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ==============================
# JWT
# ==============================
JWT_SECRET=super-secret-change-me
JWT_EXPIRES_IN=1d

# ==============================
# PostgreSQL - Base de datos central
# ==============================
DATABASE_URL=postgresql://minuta_admin:minuta_pass@localhost:5432/central_db?schema=public

POSTGRES_USER=minuta_admin
POSTGRES_PASSWORD=minuta_pass
POSTGRES_DB=central_db

# ==============================
# MinIO / S3
# ==============================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=minuta-bucket
S3_ACCESS_KEY_ID=minuta_access_key
S3_SECRET_ACCESS_KEY=minuta_secret_key
S3_FORCE_PATH_STYLE=true

MINIO_ROOT_USER=minuta_access_key
MINIO_ROOT_PASSWORD=minuta_secret_key

# ==============================
# Correo (SMTP) - Mailpit en local (UI: http://localhost:8025)
# ==============================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Minuta Digital <no-reply@minutadigital.local>"

# URL del frontend, usada para construir enlaces de activación/recuperación
FRONTEND_URL=http://localhost:5173
